{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "medium",
  "theme": "rose-pine",
  "subagents": {
    "asyncByDefault": true,
    "forceTopLevelAsync": false,
    "parallel": {
      "maxTasks": 8,
      "concurrency": 4
    },
    "agentOverrides": {
      "worker": {
        "model": "openai-codex/gpt-5.6-luna"
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-sol"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol"
      }
    }
  },
  "subagentPane": {
    "autoOpen": false,
    "syncStrategy": "foreground",
    "hotkeys": {
      "toggle": "ctrl+alt+p",
      "hide": "ctrl+alt+h",
      "show": false
    }
  },
  "hideThinkingBlock": false,
  "packages": [
    "npm:@zenobius/pi-rose-pine",
    "npm:pi-lens",
    "npm:pi-web-access",
    "npm:pi-btw",
    "npm:pi-ask-user",
    "npm:@tmustier/pi-ralph-wiggum",
    "npm:pi-subagents",
    "npm:@haispeed/pi-obsidian",
    "npm:pi-prompt-template-model"
  ],
  "extensions": [
    "./extensions",
    "~/.pi/agent/extensions/supacode"
  ],
  "skills": [
    "./skills",
    "~/.pi/agent/skills/supacode-cli"
  ],
  "prompts": [
    "./prompts"
  ],
  "themes": [
    "./themes"
  ],
  "lastChangelogVersion": "0.80.9",
  "quietStartup": true,
  "enabledModels": [
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna",
    "minimax/MiniMax-M3",
    "kimi-coding/k3"
  ],
  "commitMessage": {
    "yeet": {
      "model": "openai-codex/gpt-5.6-luna",
      "reasoning": "medium"
    }
  }
}
