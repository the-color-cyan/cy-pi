{
  "name": "cy-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Portable pi agent home resources for Cyan.",
  "keywords": [
    "pi-agent-home"
  ],
  "type": "module",
  "scripts": {
    "test": "bash -n scripts/*.sh && npm exec tsc -- --noEmit && node --test --experimental-strip-types tests/*.test.ts"
  },
  "files": [
    "AGENTS.md",
    "APPEND_SYSTEM.md",
    "SUBAGENTS_ASYNC_PLAYBOOK.md",
    "commit-message-prompt.md",
    "agents",
    "extensions",
    "prompts",
    "scripts",
    "settings.example.json",
    "skills",
    "themes"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "dependencies": {
    "typebox": "^1.1.34"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.70.5",
    "@mariozechner/pi-coding-agent": "^0.70.5",
    "@mariozechner/pi-tui": "^0.70.5",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
