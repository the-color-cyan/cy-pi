{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "xhigh",
  "theme": "rose-pine",
  "subagents": {
    "asyncByDefault": true,
    "forceTopLevelAsync": false,
    "defaultSessionDir": "~/.pi/agent/sessions/subagent",
    "parallel": {
      "maxTasks": 8,
      "concurrency": 4
    },
    "agentOverrides": {
      "worker": {
        "model": "k2p6"
      }
    }
  },
  "subagentPane": {
    "autoOpen": false,
    "syncStrategy": "foreground",
    "hotkeys": {
      "toggle": "ctrl+alt+p",
      "hide": "ctrl+alt+h",
      "show": false
    }
  },
  "hideThinkingBlock": false
}
